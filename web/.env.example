# Copy to .env.local for local development. Never put real secrets in this file.

# Image generation backend: comfyui (default) or fooocus
IMAGE_GENERATION_BACKEND=comfyui

# ComfyUI: required when IMAGE_GENERATION_BACKEND=comfyui
COMFYUI_API_URL=https://replace-with-your-runpod-comfyui-url
COMFYUI_WORKFLOW_FILE=config/comfyui-workflow-api.json
# Only set if your authenticated proxy explicitly accepts Authorization: Bearer.
# The standard ComfyUI server does not enable this authentication by default.
# COMFYUI_API_KEY=

# Fooocus alternative: required when IMAGE_GENERATION_BACKEND=fooocus
# FOOOCUS_API_URL=https://replace-with-your-fooocus-api-url
# FOOOCUS_API_KEY=

# Optional Supabase public client settings. The app currently has fallback values
# in web/lib/supabase.ts; set these when using a different Supabase project.
# These must be the project's public URL and anon/publishable key, never service_role.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
